[Desktop Entry]
Name=fyrSheets
GenericName=Spreadsheet Editor
Comment=fyrSheets — OpenDocument (.ods), Excel (.xlsx), & CSV Spreadsheet Studio for FyrDE (fyrOffice).
Exec=/usr/local/bin/fyrsheets %f
Icon=fyrsheets
Terminal=false
Type=Application
Categories=Office;Spreadsheet;
MimeType=application/vnd.oasis.opendocument.spreadsheet;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel;text/csv;text/tab-separated-values;
Keywords=office;fyrsheets;fyroffice;excel;calc;ods;xlsx;csv;spreadsheet;formulas;charts;
