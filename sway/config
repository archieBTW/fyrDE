output * bg ~/.config/fyr/space.jpg fill

exec /opt/fyrtaskbar/fyrtaskbar
exec /opt/fyrtaskbar/fyrtaskbar --desktop
exec /opt/fyrdock/fyrdock
exec --no-startup-id /opt/fyrsearch/fyrsearch

# Taskbar window rules
for_window [app_id="fyrtaskbar"] floating enable
for_window [app_id="fyrtaskbar"] border none
for_window [app_id="fyrtaskbar"] move position 0 0
for_window [app_id="fyrtaskbar"] sticky enable
layer_effects "fyrtaskbar" blur enable; blur_ignore_transparent enable
layer_effects "fyrdock" blur enable; blur_ignore_transparent enable


# -------------------------------------------------------------
# Mod Key setup (Super/Windows key)
# -------------------------------------------------------------
set $mod Mod4

# -------------------------------------------------------------
# Aesthetics & Window Styling
# -------------------------------------------------------------
default_border auto 4
default_floating_border auto 4
titlebar_separator disable
font pango:Sans Medium 10
gaps inner 20
gaps outer 20
corner_radius 12
blur enable
blur_passes 3
shadows enable
shadow_blur_radius 30 
shadow_color #00000080
scratchpad_minimize enable
client.focused #800080 #800080 #ffffff #800080 #800080
# Set animation duration in milliseconds (e.g., 300ms)
animation_duration_ms 300

# -------------------------------------------------------------
# Keybindings
# -------------------------------------------------------------
bindsym $mod+q exec ~/.config/fyr/close_window.sh
bindsym Mod1+Tab exec $HOME/.config/fyr/alttab.py
bindsym Mod1+Shift+Tab exec $HOME/.config/fyr/alttab.py --prev
bindsym XF86AudioRaiseVolume exec ~/.config/fyr/osd.sh vol-up
bindsym XF86AudioLowerVolume exec ~/.config/fyr/osd.sh vol-down
bindsym XF86AudioMute exec ~/.config/fyr/osd.sh vol-mute
bindsym XF86AudioMicMute exec ~/.config/fyr/osd.sh mic-mute
bindsym XF86MonBrightnessUp exec ~/.config/fyr/osd.sh bright-up
bindsym XF86MonBrightnessDown exec ~/.config/fyr/osd.sh bright-down

layer_effects "fyrosd" blur enable; corner_radius 18
bindsym Print exec ~/.config/fyr/screenshot.sh full
bindsym Shift+Print exec ~/.config/fyr/screenshot.sh region
bindsym Alt+Print exec ~/.config/fyr/screenshot.sh window
bindsym $mod+Print exec ~/.config/fyr/toggle_recording.sh
bindsym $mod+t exec fyrterm
bindsym $mod+f exec fyrfiles
bindsym $mod+m exec ~/.config/fyr/toggle_floating.sh
bindsym $mod+l exec ~/.config/fyr/lock.sh
# Idle lock, lid-close lock, and display power rules are managed in
# ~/.config/sway/conf.d/40-power.conf (configurable in fyrSettings -> Power & Lock).

# -------------------------------------------------------------
# Window Splits
# -------------------------------------------------------------
# Split the current container vertically or horizontally (only when tiling)
bindsym $mod+v [con_id=__focused__ tiling] split v
bindsym $mod+h [con_id=__focused__ tiling] split h

# -------------------------------------------------------------
# Workspaces
# -------------------------------------------------------------
# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

#bindgesture swipe:3:left exec 'curr=$(swaymsg -t get_workspaces | jq -r ".[] | select(.focused==true).num"); swaymsg workspace number $((curr - 1 < 1 ? 1 : curr - 1))'
bindgesture swipe:3:left exec 'curr=$(swaymsg -t get_workspaces | jq -r ".[] | select(.focused==true).num"); [ $curr -gt 1 ] && swaymsg workspace number $((curr - 1))'
bindgesture swipe:3:right exec 'curr=$(swaymsg -t get_workspaces | jq -r ".[] | select(.focused==true).num"); swaymsg workspace number $((curr + 1))'

# -------------------------------------------------------------
# Window Focus
# -------------------------------------------------------------
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# -------------------------------------------------------------
# Window Resizing
# -------------------------------------------------------------
bindsym $mod+Shift+Left  exec 'swaymsg resize shrink right 20px || swaymsg resize grow left 20px'
bindsym $mod+Shift+Down  exec 'swaymsg resize grow down 20px    || swaymsg resize shrink up 20px'
bindsym $mod+Shift+Up    exec 'swaymsg resize shrink down 20px  || swaymsg resize grow up 20px'
bindsym $mod+Shift+Right exec 'swaymsg resize grow right 20px   || swaymsg resize shrink left 20px'

# -------------------------------------------------------------
# Wayland Environment & Portals
# -------------------------------------------------------------
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway; systemctl --user restart xdg-desktop-portal
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 || /usr/libexec/polkit-gnome-authentication-agent-1 || /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 || /usr/bin/lxqt-policykit-agent

# -------------------------------------------------------------
# Status Bar
# -------------------------------------------------------------
# Disable the default swaybar
bar {
    mode invisible
}

# ==========================================
# Fyrsearch Sway Configuration
# ==========================================
layer_effects "fyrsearch" blur enable
bindsym $mod+space exec ~/.config/fyr/launcher_toggle.sh


# ==========================================
# Fyroverview & Fyrwindowoverview Sway Configuration
# ==========================================
exec /opt/fyroverview/fyroverview
exec /opt/fyrwindowoverview/fyrwindowoverview

layer_effects "fyroverview" blur enable
layer_effects "fyrwindowoverview" blur enable

# Super + Tab and Super + W
bindsym $mod+Tab exec ~/.config/fyr/overview_toggle.sh
bindsym $mod+w exec ~/.config/fyr/overview_toggle.sh workspace

# Gestures
bindgesture swipe:3:down exec ~/.config/fyr/overview_toggle.sh back
bindgesture swipe:3:up exec ~/.config/fyr/overview_toggle.sh hide


# ==========================================
# Fyrhelp Sway Configuration
# ==========================================
exec /opt/fyrhelp/fyrhelp
for_window [app_id="fyrhelp"] floating enable, border none, move scratchpad
bindsym $mod+Control_L exec ~/.config/fyr/help_toggle.sh
bindsym $mod+Control_R exec ~/.config/fyr/help_toggle.sh
bindsym $mod+Ctrl exec ~/.config/fyr/help_toggle.sh


# ==========================================
# Fyremoji Sway Configuration
# ==========================================
exec /opt/fyremoji/fyremoji
layer_effects "fyremoji" blur enable; corner_radius 16
bindsym $mod+period exec ~/.config/fyr/emoji_toggle.sh


# ==========================================
# Fyrclipboard Sway Configuration
# ==========================================
exec /opt/fyrclipboard/fyrclipboard
layer_effects "fyrclipboard" blur enable; corner_radius 16
bindsym Mod1+v exec ~/.config/fyr/clipboard_toggle.sh


# ==========================================
# FyrMonitor Sway Configuration
# ==========================================
# Task Manager: focus the existing window or launch it (Ctrl + Shift + Esc).
# Both the keysym and the modifier spelling are bound; monitor_toggle.sh is
# flock-guarded, so an accidental double match can never open two windows.
bindsym Control_L+Shift_L+Escape exec ~/.config/fyr/monitor_toggle.sh
bindsym Ctrl+Shift+Escape exec ~/.config/fyr/monitor_toggle.sh


include ~/.config/sway/floating.conf
# Keep Fyr overlay/panel surfaces borderless and native Flutter CSD apps free of duplicate SSD titlebars
for_window [app_id="^(fyrtaskbar|fyrdock|fyrdesktop|fyrsearch|launcher|fyroverview|fyrwindowoverview|fyrhelp|fyremoji|fyrclipboard)$"] border none
for_window [app_id="^dev\.fyrde\..+$"] border pixel 4

# User-managed settings (preserved across updates)
include ~/.config/sway/conf.d/*.conf

